---
import Base from "../layouts/Base.astro";
import ToolCard from "../components/ToolCard.astro";
import { tools, otherRepos } from "../data/tools";
import { site } from "../data/site";
---

<Base title="Methods" description="Methods and open-source tools for QM, QM/MM and MM simulations of enzymes, developed by Miquel Estévez-Gay.">
  <div class="page-head" slot="head">
    <p class="eyebrow">Method development</p>
    <h1>Methods I develop</h1>
    <p>I write the methods behind my simulations: QM workflows with machine-learned potentials and transition-state searches, QM/MM charges derived inside the protein, and MM set-up and analysis. Each is open source on <a href={site.links.github}>GitHub</a>.</p>
  </div>
  <section class="block">
    <div class="wrap">
      <div class="tools">
        {tools.map((t) => <ToolCard {...t} />)}
      </div>
    </div>
  </section>
  <section class="block">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Also on GitHub</p></div>
      <div class="pubs">
        {
          otherRepos.map((r) => (
            <div class="pub">
              <span class="yr">{r.pushed.slice(0, 4)}</span>
              <div>
                <a class="t" href={r.url}>{r.name}</a>
                {r.description && <span class="au">{r.description}</span>}
                <span class="v">{r.language && <em>{r.language}</em>}</span>
              </div>
              <span class="c">{r.stars ? `★ ${r.stars}` : ""}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
