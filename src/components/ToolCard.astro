---
interface Props {
  name: string;
  url: string;
  blurb: string;
  level: string;
  stack: string;
  stars: number;
  post?: string;
}
const { name, url, blurb, level, stack, stars, post } = Astro.props;
---

<article class="tool">
  <span class="kind real">{level}</span>
  <header>
    <h3><a href={url}>{name}</a></h3>
    <span class="stars">{stars > 0 ? `★ ${stars}` : ""}</span>
  </header>
  <p>{blurb}</p>
  <p class="stack">{stack}{post && <> · <a href={post} style="position:relative;z-index:1">blog post</a></>}</p>
</article>
